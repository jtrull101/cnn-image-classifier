# Image Classifier Configuration
# Copy this to .env and customize as needed
# All variables are prefixed with IMG_CLASSIFIER_

# API Security
# Set this to a strong random secret to enable API key authentication.
# Leave unset to disable auth (development / local mode).
# IMG_CLASSIFIER_API_KEY=change-me-to-a-strong-random-secret

# File Upload Limits
# Maximum upload size in bytes (default: 10485760 = 10 MB)
# IMG_CLASSIFIER_MAX_UPLOAD_BYTES=10485760

# Model Directories
# Primary directory for user-supplied model files.
# The API only loads models from this directory and the built-in defaults.
# IMG_CLASSIFIER_MODEL_DIR=/path/to/your/models

# Project Settings
# IMG_CLASSIFIER_PROJECT_NAME=img_classifier
# Directory for training artefacts (default: ~/.local/share/img_classifier/training)
# IMG_CLASSIFIER_WORKING_DIR=/path/to/working/dir

# Training Hyperparameters
# IMG_CLASSIFIER_BATCH_SIZE=32
# IMG_CLASSIFIER_NUM_EPOCHS=25
# IMG_CLASSIFIER_LEARNING_RATE=0.001
# IMG_CLASSIFIER_VALIDATION_SPLIT=0.2

# Model Settings
# IMG_CLASSIFIER_DROPOUT_RATE=0.3
# IMG_CLASSIFIER_EARLY_STOPPING_PATIENCE=20
# IMG_CLASSIFIER_MIN_ACCURACY_TO_SAVE=0.98

# Data Settings
# IMG_CLASSIFIER_DATA_PERCENT=1.0
# IMG_CLASSIFIER_IMAGE_SIZE=128,128
# IMG_CLASSIFIER_COLOR_CHANNELS=3

# Callbacks
# IMG_CLASSIFIER_USE_EARLY_STOPPING=true
# IMG_CLASSIFIER_USE_CHECKPOINTING=true

