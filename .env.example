# Alzheimer's MRI CNN Configuration
# Copy this to .env and customize as needed
# All variables are prefixed with ALZ_MRI_

# Project Settings
# ALZ_MRI_PROJECT_NAME=alzheimer_mri_cnn
# ALZ_MRI_WORKING_DIR=/tmp/alz_mri_cnn

# Training Hyperparameters
# ALZ_MRI_BATCH_SIZE=32
# ALZ_MRI_NUM_EPOCHS=25
# ALZ_MRI_LEARNING_RATE=0.001
# ALZ_MRI_VALIDATION_SPLIT=0.2

# Model Settings
# ALZ_MRI_DROPOUT_RATE=0.3
# ALZ_MRI_EARLY_STOPPING_PATIENCE=20
# ALZ_MRI_MIN_ACCURACY_TO_SAVE=0.98

# Data Settings
# ALZ_MRI_DATA_PERCENT=1.0
# ALZ_MRI_IMAGE_SIZE=128,128
# ALZ_MRI_COLOR_CHANNELS=3

# Callbacks
# ALZ_MRI_USE_EARLY_STOPPING=true
# ALZ_MRI_USE_CHECKPOINTING=true

