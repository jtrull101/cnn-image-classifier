#!/bin/sh
# Git pre-commit hook
# This runs automatically before each commit

echo ""
echo "========================================="
echo "Running pre-commit checks..."
echo "========================================="
echo ""

# Function to get UV command
get_uv_command() {
    if command -v uv >/dev/null 2>&1; then
        echo "uv"
    elif [ -f "$HOME/.local/bin/uv" ]; then
        echo "$HOME/.local/bin/uv"
    else
        echo ""
    fi
}

UV_CMD=$(get_uv_command)

if [ -z "$UV_CMD" ]; then
    echo "[ERROR] UV not found. Please install UV first."
    exit 1
fi

ERROR_COUNT=0

# Run format, lint, and typecheck in parallel for better efficiency
echo "Running formatting, linting, and type checks in parallel..."
echo ""

# Create temporary files to capture exit codes
TEMP_DIR=$(mktemp -d)
FORMAT_STATUS="$TEMP_DIR/format_status"
LINT_STATUS="$TEMP_DIR/lint_status"
TYPECHECK_STATUS="$TEMP_DIR/typecheck_status"

# Run tasks in parallel
(
    echo "[1/3] Formatting code with ruff..."
    "$UV_CMD" run ruff format .
    echo $? > "$FORMAT_STATUS"
    if [ $? -ne 0 ]; then
        echo "[ERROR] Formatting failed"
    else
        echo "[OK] Formatting complete"
    fi
) &

(
    echo "[2/3] Linting code with ruff..."
    "$UV_CMD" run ruff check apps packages scripts tests
    echo $? > "$LINT_STATUS"
    if [ $? -ne 0 ]; then
        echo "[ERROR] Linting failed"
    else
        echo "[OK] Linting passed"
    fi
) &

(
    echo "[3/3] Running type checks with pyright..."
    "$UV_CMD" run pyright
    echo $? > "$TYPECHECK_STATUS"
    if [ $? -ne 0 ]; then
        echo "[ERROR] Type checking failed"
    else
        echo "[OK] Type checking passed"
    fi
) &

# Wait for all parallel tasks to complete
wait

# Check results
echo ""
if [ $(cat "$FORMAT_STATUS") -ne 0 ]; then
    ERROR_COUNT=$((ERROR_COUNT + 1))
fi

if [ $(cat "$LINT_STATUS") -ne 0 ]; then
    ERROR_COUNT=$((ERROR_COUNT + 1))
fi

if [ $(cat "$TYPECHECK_STATUS") -ne 0 ]; then
    ERROR_COUNT=$((ERROR_COUNT + 1))
fi

# Cleanup
rm -rf "$TEMP_DIR"
echo ""

# Run tests
echo "[4/4] Running smoke tests..."
"$UV_CMD" run python -m pytest -c pyproject.toml --rootdir . -v -m smoke --maxfail=3
if [ $? -ne 0 ]; then
    echo "[ERROR] Smoke tests failed"
    ERROR_COUNT=$((ERROR_COUNT + 1))
else
    echo "[OK] Smoke tests passed"
fi
echo ""

# Summary
echo "========================================="
if [ $ERROR_COUNT -eq 0 ]; then
    echo "[OK] All checks passed!"
    echo "========================================="
    exit 0
else
    echo "[ERROR] $ERROR_COUNT check(s) failed!"
    echo "========================================="
    echo ""
    echo "Commit blocked. Please fix the issues above."
    exit 1
fi

